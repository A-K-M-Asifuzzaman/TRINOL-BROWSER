  <translations/>
  <release seq="1">
    <messages fallback_to_english="true">
      <message name="IDS_TRINOL_NEW_TAB_TITLE" desc="Title of the Trinol browser New Tab page.">Trinol — New tab</message>
      <message name="IDS_TRINOL_NEW_TAB_HEADLINE" desc="Main heading of the Trinol New Tab page.">Where to next?</message>
      <message name="IDS_TRINOL_NEW_TAB_SEARCH" desc="Button that moves keyboard focus to the real browser address bar.">Search or enter an address</message>
      <message name="IDS_TRINOL_NEW_TAB_SEARCH_HINT" desc="Description of the native address bar entry button.">Search with your preferred engine, or open a website.</message>
      <message name="IDS_TRINOL_NEW_TAB_SITES" desc="Heading for the site shortcuts area.">Your sites</message>
      <message name="IDS_TRINOL_NEW_TAB_SITES_UNAVAILABLE" desc="Honest empty state while site shortcut integration is unavailable.">Site shortcuts are not available on this page yet.</message>
      <message name="IDS_TRINOL_NEW_TAB_HISTORY" desc="Link that opens the browser history page.">Open history</message>
      <message name="IDS_TRINOL_NEW_TAB_APPEARANCE" desc="Link that opens browser appearance settings.">Appearance</message>
      <message name="IDS_TRINOL_NEW_TAB_FOCUS_UNAVAILABLE" desc="Status when the page cannot focus the native browser address bar.">Select this tab and use the address bar shortcut to continue.</message>
    </messages>
  </release>
