diff --git a/chrome/browser/resources/new_tab_page_third_party/orbit.css b/chrome/browser/resources/new_tab_page_third_party/orbit.css
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/new_tab_page_third_party/orbit.css
@@ -0,0 +1,196 @@
+/* Trinol Orbit. Approved Phase 2A palette, typography and mark composition. */
+:root {
+  color-scheme: light;
+  --page: #fbfcfe;
+  --surface: #f2f5fa;
+  --text: #172234;
+  --muted: #526078;
+  --line: #cbd4e1;
+  --accent: #245dc2;
+  --wash: #dce8ff;
+  --cyan: #006781;
+  background-color: var(--page);
+  color: var(--text);
+  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+}
+
+:root[dark] {
+  color-scheme: dark;
+  --page: #131820;
+  --surface: #191e27;
+  --text: #f4f6fa;
+  --muted: #a5b0c0;
+  --line: #303a49;
+  --accent: #86b1ff;
+  --wash: #233854;
+  --cyan: #69d8f5;
+}
+
+:root[custom-theme] { --muted: var(--text);
+ --accent: var(--text); }
+
+* { box-sizing: border-box; }
+
+body { margin: 0;
+ min-inline-size: 0; }
+
+main {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  margin-inline: auto;
+  max-inline-size: 1200px;
+  min-block-size: 100dvh;
+  padding: clamp(48px, 12vh, 120px) clamp(24px, 7vw, 96px) 32px;
+  position: relative;
+}
+
+.content { inline-size: 100%;
+ padding-block: 32px 80px;
+ position: relative; }
+
+.wordmark { align-items: center;
+ display: flex;
+ font-size: 30px;
+ font-weight: 600;
+ gap: 12px;
+ letter-spacing: -1.3px; }
+
+.orbit-mark { color: var(--accent);
+ block-size: 46px;
+ inline-size: 46px;
+ flex: none; }
+
+.orbit-mark circle { fill: var(--cyan); }
+
+h1 { font-size: clamp(40px, 5vw, 66px);
+ font-weight: 550;
+ letter-spacing: -.045em;
+ line-height: 1.1;
+ margin-block: 28px 32px;
+ overflow-wrap: anywhere; }
+
+#search {
+  align-items: center;
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  color: var(--muted);
+  cursor: pointer;
+  display: flex;
+  font: inherit;
+  gap: 16px;
+  inline-size: min(100%, 700px);
+  min-block-size: 60px;
+  padding: 16px 20px;
+  position: relative;
+  text-align: start;
+}
+
+#search svg { block-size: 22px;
+ color: var(--accent);
+ flex: none;
+ inline-size: 22px; }
+
+#search span { flex: 1;
+ min-inline-size: 0;
+ overflow-wrap: anywhere; }
+
+kbd { border: 1px solid var(--line);
+ border-radius: 4px;
+ flex: none;
+ font: inherit;
+ font-size: 12px;
+ padding: 2px 5px; }
+
+a { color: var(--accent);
+ text-underline-offset: 4px; }
+
+a:hover { text-decoration-thickness: 2px; }
+
+#search:hover { border-color: var(--accent); }
+
+a:focus-visible,
+ button:focus-visible { outline: 3px solid var(--accent);
+ outline-offset: 4px; }
+
+.hint,
+ .sites p { color: var(--muted);
+ font-size: 14px;
+ line-height: 1.6;
+ max-inline-size: 52ch; }
+
+.hint { margin-block: 16px 0; }
+
+#focus-status { color: var(--text);
+ font-size: 14px;
+ line-height: 1.6;
+ max-inline-size: 52ch; }
+
+#focus-status:empty { display: none; }
+
+.sites { border-block-start: 1px solid var(--line);
+ margin-block-start: 56px;
+ max-inline-size: 700px;
+ padding-block-start: 24px; }
+
+h2 { font-size: 15px;
+ font-weight: 600;
+ margin: 0; }
+
+.sites a { display: inline-block;
+ font-size: 14px;
+ padding-block: 8px; }
+
+footer { align-items: center;
+ color: var(--muted);
+ display: flex;
+ flex-wrap: wrap;
+ font-size: 13px;
+ gap: 24px;
+ justify-content: space-between;
+ margin-block-start: auto; }
+
+footer a { padding-block: 12px; }
+
+.orbit-art { color: var(--line);
+ fill: none;
+ inline-size: min(36vw, 360px);
+ inset-block-start: 13%;
+ inset-inline-end: 0;
+ opacity: .65;
+ pointer-events: none;
+ position: absolute;
+ stroke: currentColor;
+ stroke-width: .8; }
+
+.orbit-art circle { fill: var(--cyan);
+ stroke: none; }
+
+:root[custom-theme] .orbit-art { visibility: hidden; }
+@media (max-width: 600px) {
+  main { padding: 40px 24px 24px; }
+  .content { padding-block: 24px 48px; }
+  .orbit-art { display: none; }
+  #search { gap: 12px;
+ padding: 16px; }
+  kbd { display: none; }
+  .sites { margin-block-start: 40px; }
+}
+@media (forced-colors: active) {
+  :root,
+ :root[dark] { --page: Canvas !important;
+ --surface: Canvas !important;
+ --text: CanvasText !important;
+ --muted: CanvasText !important;
+ --line: CanvasText !important;
+ --accent: LinkText !important;
+ --cyan: LinkText !important; }
+  :root { background-image: none !important; }
+  .orbit-art { display: none; }
+}
+@media (prefers-reduced-motion: reduce) { *,
+ *::before,
+ *::after { animation: none !important;
+ transition: none !important;
+ scroll-behavior: auto !important; } }
