@@ -0,0 +1,79 @@
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search/search.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/browser/ui/webui/new_tab_page_third_party/new_tab_page_third_party_handler.h"
+#include "chrome/browser/ui/webui/new_tab_page_third_party/new_tab_page_third_party_ui.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/new_tab_page_third_party_resources_map.h"
+#include "chrome/test/base/chrome_test_utils.h"
+#include "chrome/test/base/search_test_utils.h"
+#include "chrome/test/base/web_ui_mocha_browser_test.h"
+#include "chrome/test/base/web_ui_test_data_source.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+#include "content/public/test/browser_test.h"
+
+class TrinolNewTabBrowserTest : public WebUIMochaBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    WebUIMochaBrowserTest::SetUpOnMainThread();
+    auto* source = webui::CreateAndAddWebUITestDataSource(
+        chrome_test_utils::GetProfile(this));
+    // Alias the actual compiled modules only in the test data source.
+    for (const auto& resource : kNewTabPageThirdPartyResources) {
+      source->AddResourcePath(std::string("orbit-production/") + resource.path,
+                              resource.id);
+    }
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(TrinolNewTabBrowserTest, ClientBehavior) {
+  RunTest("new_tab_page_third_party/orbit_test.js", "mocha.run()");
+}
+
+IN_PROC_BROWSER_TEST_F(TrinolNewTabBrowserTest,
+                       LocalRouteAndOffRecordExclusion) {
+  Profile* profile = chrome_test_utils::GetProfile(this);
+  EXPECT_EQ(GURL(chrome::kChromeUINewTabPageThirdPartyURL),
+            search::GetNewTabPageURL(profile));
+  Profile* otr = profile->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  EXPECT_EQ(GURL(), search::GetNewTabPageURL(otr));
+  NewTabPageThirdPartyUIConfig config;
+  EXPECT_FALSE(config.IsWebUIEnabled(otr));
+}
+
+IN_PROC_BROWSER_TEST_F(TrinolNewTabBrowserTest,
+                       ConfiguredProviderRemoteNtpPreserved) {
+  auto* service = TemplateURLServiceFactory::GetForProfile(
+      chrome_test_utils::GetProfile(this));
+  search_test_utils::WaitForTemplateURLServiceToLoad(service);
+  TemplateURLData data;
+  data.SetShortName(u"Test provider");
+  data.SetKeyword(u"provider.test");
+  data.SetURL("https://provider.test/search?q={searchTerms}");
+  data.new_tab_url = "https://provider.test/newtab";
+  auto* provider = service->Add(std::make_unique<TemplateURL>(data));
+  service->SetUserSelectedDefaultSearchProvider(provider);
+  EXPECT_EQ(GURL(data.new_tab_url),
+            search::GetNewTabPageURL(chrome_test_utils::GetProfile(this)));
+  EXPECT_EQ(provider, service->GetDefaultSearchProvider());
+}
+
+IN_PROC_BROWSER_TEST_F(TrinolNewTabBrowserTest, FocusWithoutUserGestureDenied) {
+  mojo::Remote<new_tab_page_third_party::mojom::PageHandler> remote;
+  mojo::PendingRemote<new_tab_page_third_party::mojom::Page> page;
+  auto receiver = page.InitWithNewPipeAndPassReceiver();
+  NewTabPageThirdPartyHandler handler(
+      remote.BindNewPipeAndPassReceiver(), std::move(page),
+      chrome_test_utils::GetProfile(this),
+      chrome_test_utils::GetActiveWebContents(this));
+  bool focused = true;
+  handler.FocusOmnibox(base::BindOnce(
+      [](bool* result, bool value) { *result = value; }, &focused));
+  EXPECT_FALSE(focused);
+}
diff --git a/chrome/test/data/webui/new_tab_page_third_party/orbit_test.ts b/chrome/test/data/webui/new_tab_page_third_party/orbit_test.ts
new file mode 100644
--- /dev/null
+++ b/chrome/test/data/webui/new_tab_page_third_party/orbit_test.ts
@@ -0,0 +1,94 @@
+import {BrowserProxy} from 'chrome://webui-test/orbit-production/browser_proxy.js';
+import {PageCallbackRouter} from 'chrome://webui-test/orbit-production/new_tab_page_third_party.mojom-webui.js';
+import type {PageHandlerRemote, Theme} from 'chrome://webui-test/orbit-production/new_tab_page_third_party.mojom-webui.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {assertEquals, assertFalse, assertTrue} from 'chrome://webui-test/chai_assert.js';
+import {microtasksFinished} from 'chrome://webui-test/test_util.js';
+
+suite('TrinolOrbitNewTab', () => {
+  let applyTheme: (theme: Theme) => void;
+  let calls = 0;
+  let focused = true;
+  let button: HTMLButtonElement;
+  let status: HTMLElement;
+
+  suiteSetup(async () => {
+    button = document.createElement('button');
+    button.id = 'search';
+    status = document.createElement('p');
+    status.id = 'focus-status';
+    document.body.replaceChildren(button, status);
+    loadTimeData.overrideValues({focusUnavailable: 'Use the address bar shortcut'});
+    BrowserProxy.setInstance({
+      callbackRouter: new PageCallbackRouter(),
+      handler: {
+        updateTheme() {},
+        focusOmnibox() {
+          ++calls;
+          return Promise.resolve({focused});
+        },
+      } as unknown as PageHandlerRemote,
+    });
+    const page = await import('chrome://webui-test/orbit-production/new_tab_page_third_party.js');
+    applyTheme = page.applyTheme;
+    assertEquals(0, calls, 'Initialization must not steal native omnibox focus');
+  });
+
+  setup(() => {
+    calls = 0;
+    focused = true;
+    status.textContent = '';
+  });
+
+  function theme(dark: boolean): Theme {
+    return {
+      textColor: {value: 0xff172234},
+      isDark: dark,
+      id: '',
+      colorBackground: '#fbfcfe',
+      backgroundTiling: 'no-repeat',
+      backgroundPosition: 'center',
+      hasCustomBackground: false,
+      useOrbitColors: true,
+    };
+  }
+
+  test('FocusDelegatesToNativeOmniboxWithoutQueryOrURL', async () => {
+    button.click();
+    await microtasksFinished();
+    assertEquals(1, calls);
+    assertEquals('', status.textContent);
+    assertEquals(0, document.querySelectorAll('input, form').length);
+  });
+
+  test('UnavailableFocusIsAnnounced', async () => {
+    focused = false;
+    button.click();
+    await microtasksFinished();
+    assertEquals('Use the address bar shortcut', status.textContent);
+  });
+
+  test('BrowserAppearanceUpdatesBothModes', () => {
+    applyTheme(theme(true));
+    assertTrue(document.documentElement.hasAttribute('dark'));
+    applyTheme(theme(false));
+    assertFalse(document.documentElement.hasAttribute('dark'));
+    assertFalse(document.documentElement.hasAttribute('custom-theme'));
+    assertEquals('', document.documentElement.style.getPropertyValue('--page'));
+  });
+
+  test('CustomThemeIsPreservedAndThemeIdentifierIsEncoded', () => {
+    const custom = theme(false);
+    custom.useOrbitColors = false;
+    custom.colorBackground = '#123456';
+    custom.hasCustomBackground = true;
+    custom.id = 'theme) id';
+    applyTheme(custom);
+    const html = document.documentElement;
+    assertTrue(html.hasAttribute('custom-theme'));
+    assertEquals('#123456', html.style.getPropertyValue('--page'));
+    assertTrue(html.style.backgroundImage.includes(new URLSearchParams({id: custom.id}).toString()));
+    applyTheme(theme(false));
+    assertEquals('none', html.style.backgroundImage);
+  });
+});
