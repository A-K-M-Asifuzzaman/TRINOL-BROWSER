+void NewTabPageThirdPartyHandler::FocusOmnibox(FocusOmniboxCallback callback) {
+  auto* browser = webui::GetBrowserWindowInterface(web_contents_);
+  auto* window = browser ? BrowserWindow::FromBrowser(browser) : nullptr;
+  auto* frame = web_contents_->GetPrimaryMainFrame();
+  const bool allowed =
+      !profile_->IsOffTheRecord() && !profile_->IsGuestSession() &&
+      web_contents_->GetBrowserContext() == profile_ && browser && window &&
+      browser->GetProfile() == profile_ &&
+      NewTabPageThirdPartyUI::IsNewTabPageOrigin(
+          web_contents_->GetLastCommittedURL()) &&
+      web_contents_->GetVisibility() == content::Visibility::VISIBLE && frame &&
+      frame->HasTransientUserActivation();
+  if (allowed) {
+    window->SetFocusToLocationBar(true);
+  }
+  std::move(callback).Run(allowed);
+}
