+#if BUILDFLAG(IS_MAC)
+TEST(TrinolOrbitColorMixerTest, LightAndDarkBaselineShellContrast) {
+  for (bool dark : {false, true}) {
+    ui::ColorProvider provider;
+    ui::ColorProviderKey key;
+    key.color_mode = dark ? ui::ColorProviderKey::ColorMode::kDark
+                          : ui::ColorProviderKey::ColorMode::kLight;
+    key.user_color_source = ui::ColorProviderKey::UserColorSource::kBaseline;
+    ui::AddColorMixers(&provider, key);
+    AddChromeColorMixers(&provider, key);
+    const SkColor surface = dark ? SkColorSetRGB(0x19, 0x1e, 0x27)
+                                 : SkColorSetRGB(0xf2, 0xf5, 0xfa);
+    EXPECT_EQ(surface, provider.GetColor(kColorToolbar));
+    EXPECT_EQ(surface, provider.GetColor(kColorTabBackgroundActiveFrameActive));
+    EXPECT_NE(provider.GetColor(kColorTabBackgroundInactiveFrameActive),
+              provider.GetColor(kColorTabBackgroundInactiveFrameInactive));
+    for (const auto pair : {
+             std::pair{kColorToolbarText, kColorToolbar},
+             std::pair{kColorTabForegroundActiveFrameActive,
+                       kColorTabBackgroundActiveFrameActive},
+             std::pair{kColorTabForegroundActiveFrameInactive,
+                       kColorTabBackgroundActiveFrameInactive},
+             std::pair{kColorTabForegroundInactiveFrameActive,
+                       kColorTabBackgroundInactiveFrameActive},
+             std::pair{kColorTabForegroundInactiveFrameInactive,
+                       kColorTabBackgroundInactiveFrameInactive}}) {
+      EXPECT_GE(color_utils::GetContrastRatio(provider.GetColor(pair.first),
+                                              provider.GetColor(pair.second)),
+                4.5f);
+    }
+    EXPECT_GE(color_utils::GetContrastRatio(
+                  provider.GetColor(kColorTabFocusRingActive), surface),
+              3.0f);
+    EXPECT_NE(provider.GetColor(kColorToolbarButtonIconDisabled),
+              provider.GetColor(kColorToolbarButtonIcon));
+  }
+}
+
+TEST(TrinolOrbitColorMixerTest, AccessibilityAndIncognitoKeepUpstreamPalette) {
+  for (int variant : {0, 1, 2}) {
+    ui::ColorProvider provider;
+    ui::ColorProviderKey key;
+    key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+    key.user_color_source = ui::ColorProviderKey::UserColorSource::kBaseline;
+    if (variant == 0) {
+      key.contrast_mode = ui::ColorProviderKey::ContrastMode::kHigh;
+    } else if (variant == 1) {
+      key.forced_colors = ui::ColorProviderKey::ForcedColors::kSystem;
+    } else {
+      // ThemeService uses grayscale and dark mode for incognito.
+      key.user_color_source = ui::ColorProviderKey::UserColorSource::kGrayscale;
+    }
+    ui::AddColorMixers(&provider, key);
+    AddChromeColorMixers(&provider, key);
+    EXPECT_NE(SkColorSetRGB(0x19, 0x1e, 0x27),
+              provider.GetColor(kColorToolbar));
+  }
+}
+
+TEST(TrinolOrbitColorMixerTest, UserAndExtensionThemesKeepUpstreamPalette) {
+  for (bool extension : {false, true}) {
+    ui::ColorProvider provider;
+    ui::ColorProviderKey key;
+    key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+    key.user_color_source = ui::ColorProviderKey::UserColorSource::kBaseline;
+    if (extension) {
+      key.custom_theme = base::WrapRefCounted(new CustomThemeSupplier(
+          ui::ColorProviderKey::ThemeInitializerSupplier::ThemeType::kExtension));
+    } else {
+      key.user_color = SkColorSetRGB(0xa0, 0x40, 0x20);
+      key.user_color_source = ui::ColorProviderKey::UserColorSource::kAccent;
+    }
+    ui::AddColorMixers(&provider, key);
+    AddChromeColorMixers(&provider, key);
+    EXPECT_NE(SkColorSetRGB(0x19, 0x1e, 0x27),
+              provider.GetColor(kColorToolbar));
+  }
+}
+#endif  // BUILDFLAG(IS_MAC)
+
 }  // namespace
