+// Orbit owns only the uncustomized baseline shell. Incognito uses grayscale;
+// user/extension themes, app windows and accessibility palettes stay upstream.
+void AddTrinolOrbitColorMixer(ui::ColorProvider* provider,
+                             const ui::ColorProviderKey& key) {
+  if (key.custom_theme || key.app_controller || key.user_color.has_value() ||
+      key.user_color_source != ui::ColorProviderKey::UserColorSource::kBaseline ||
+      key.contrast_mode != ui::ColorProviderKey::ContrastMode::kNormal ||
+      key.forced_colors != ui::ColorProviderKey::ForcedColors::kNone ||
+      key.system_theme != ui::SystemTheme::kDefault ||
+      key.frame_type != ui::ColorProviderKey::FrameType::kChromium) {
+    return;
+  }
+
+  const bool dark = key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  const SkColor frame = dark ? SkColorSetRGB(0x10, 0x13, 0x19)
+                            : SkColorSetRGB(0xe7, 0xec, 0xf3);
+  const SkColor inactive_frame = dark ? SkColorSetRGB(0x1c, 0x22, 0x2c)
+                                     : SkColorSetRGB(0xdf, 0xe5, 0xee);
+  const SkColor surface = dark ? SkColorSetRGB(0x19, 0x1e, 0x27)
+                              : SkColorSetRGB(0xf2, 0xf5, 0xfa);
+  const SkColor hover = dark ? SkColorSetRGB(0x24, 0x2b, 0x37)
+                            : SkColorSetRGB(0xe2, 0xe9, 0xf3);
+  const SkColor selected = dark ? SkColorSetRGB(0x23, 0x38, 0x54)
+                               : SkColorSetRGB(0xdc, 0xe8, 0xff);
+  const SkColor text = dark ? SkColorSetRGB(0xf4, 0xf6, 0xfa)
+                           : SkColorSetRGB(0x17, 0x22, 0x34);
+  const SkColor muted = dark ? SkColorSetRGB(0xa5, 0xb0, 0xc0)
+                            : SkColorSetRGB(0x52, 0x60, 0x78);
+  const SkColor accent = dark ? SkColorSetRGB(0x86, 0xb1, 0xff)
+                             : SkColorSetRGB(0x24, 0x5d, 0xc2);
+  const SkColor line = dark ? SkColorSetRGB(0x30, 0x3a, 0x49)
+                           : SkColorSetRGB(0xcb, 0xd4, 0xe1);
+
+  ui::ColorMixer& mixer = provider->AddMixer();
+  mixer[ui::kColorFrameActive] = {frame};
+  mixer[ui::kColorFrameInactive] = {inactive_frame};
+  mixer[kColorToolbar] = {surface};
+  mixer[kColorToolbarTextDefault] = {text};
+  mixer[kColorToolbarButtonText] = {text};
+  mixer[kColorToolbarButtonIconDefault] = {muted};
+  mixer[kColorToolbarButtonIconHovered] = {accent};
+  mixer[kColorToolbarButtonIconPressed] = {accent};
+  mixer[kColorToolbarButtonIconDisabled] =
+      ui::AlphaBlend(muted, surface, 0x61);
+  mixer[kColorToolbarButtonIconInactive] = {muted};
+  mixer[kColorToolbarButtonBorder] = {line};
+  mixer[kColorToolbarInkDropHover] = {hover};
+  mixer[kColorToolbarContentAreaSeparator] = {line};
+  mixer[kColorToolbarSeparatorDefault] = {line};
+  mixer[kColorToolbarTopSeparatorFrameActive] = {line};
+  mixer[kColorToolbarTopSeparatorFrameInactive] = {line};
+  // Keep the real omnibox text, suggestion, PageInfo and security color recipes.
+  mixer[kColorLocationBarBackground] = {frame};
+  mixer[kColorLocationBarBackgroundHovered] = {hover};
+  mixer[kColorLocationBarBorder] = {line};
+
+  mixer[kColorTabBackgroundActiveFrameActive] = {surface};
+  mixer[kColorTabBackgroundActiveFrameInactive] = {surface};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {frame};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {inactive_frame};
+  mixer[kColorTabBackgroundInactiveHoverFrameActive] = {hover};
+  mixer[kColorTabBackgroundInactiveHoverFrameInactive] = {hover};
+  mixer[kColorTabBackgroundSelectedFrameActive] = {selected};
+  mixer[kColorTabBackgroundSelectedFrameInactive] = {hover};
+  mixer[kColorTabBackgroundSelectedHoverFrameActive] =
+      ui::AlphaBlend(accent, selected, 0x19);
+  mixer[kColorTabBackgroundSelectedHoverFrameInactive] = {selected};
+  mixer[kColorTabForegroundActiveFrameActive] = {accent};
+  mixer[kColorTabForegroundActiveFrameInactive] = {muted};
+  mixer[kColorTabForegroundInactiveFrameActive] = {muted};
+  mixer[kColorTabForegroundInactiveFrameInactive] = {muted};
+  mixer[kColorTabFocusRingActive] = {accent};
+  mixer[kColorTabFocusRingInactive] = {accent};
+  mixer[kColorTabCloseButtonFocusRingActive] = {accent};
+  mixer[kColorTabCloseButtonFocusRingInactive] = {accent};
+  mixer[kColorTabStrokeFrameActive] = {line};
+  mixer[kColorTabStrokeFrameInactive] = {line};
+}
+#endif  // BUILDFLAG(IS_MAC)
+
 }  // namespace
 
